<?xml version="1.0" encoding="utf-8"?>
<!-- a word of the «تلاوة وأذان» screens: @color/glass_warn at rest, the focus ink (@color/on_focus) on a focused or selected row's solid fill -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/on_focus" />
    <item android:state_selected="true" android:color="@color/on_focus" />
    <item android:color="@color/glass_warn" />
</selector>
