<?xml version="1.0" encoding="utf-8"?>
<!-- The phone remote's typing into other apps: listens to NO events (no accessibilityEventTypes). canRetrieveWindowContent is for one thing only:
     when a phone sends text while another app is in front, TypeService.typeText looks for the text field at that moment, sets it, and forgets the
     screen (nothing is kept, logged or sent back). A separate service from the sleep timer's, turned on on its own by the owner. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/type_service_desc"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true" />
