<?xml version="1.0" encoding="utf-8"?>
<!-- «مؤقت النوم» and the phone remote: listens to NO events (no accessibilityEventTypes). canRetrieveWindowContent is for one thing only: when a
     phone sends text while another app is in front, SleepService.typeText looks for the text field at that moment, sets it, and forgets the
     screen (nothing is kept, logged or sent back). The other uses need no window content: the lock-screen action and Back. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/sleep_service_desc"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true" />
